{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Compiler Watch",
      "type": "process",
      "command": "powershell.exe",
      "args": [
        "-NoProfile",
        "-Command",
        "if (Get-Command regolith -ErrorAction SilentlyContinue) { regolith watch } else { dash_compiler watch }; exit $LASTEXITCODE"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "isBackground": true,
      "runOptions": {
        "runOn": "folderOpen"
      },
      "presentation": {
        "reveal": "always",
        "panel": "new",
        "focus": false
      },
      "problemMatcher": [],
      "icon": {
        "color": "terminal.ansiGreen",
        "id": "arrow-up"
      }
    }
  ]
}
